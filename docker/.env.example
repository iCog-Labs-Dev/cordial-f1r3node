# Cordial Miners demo defaults.
#
# Copy to docker/.env before running compose:
#   cp -n docker/.env.example docker/.env

RUST_LOG=info,cordial_f1r3node_adapter=debug,cordial_f1r3space_adapter=debug
# Authoritative source-build path: docker/standalone.yml builds this tag from the
# sibling f1r3node checkout plus this cordial-f1r3node workspace.
CORDIAL_SOURCE_IMAGE=cordial-f1r3node:local
CORDIAL_F1R3NODE_TEST_IMAGE=cordial-f1r3node:conformance
CORDIAL_STANDALONE_HOST=cordial.standalone
CORDIAL_RUST_BASE=rust:slim-bookworm
RUST_TOOLCHAIN=nightly-2026-02-09

# Optional prebuilt shortcut. By default it points at the source-built tag above,
# so `just demo-cordial-up-prebuilt` only succeeds after the authoritative
# `just demo-cordial-up` path has built the current integration image.
CORDIAL_F1R3NODE_IMAGE=cordial-f1r3node:local

# Development-only secp256k1 key used in the demo runbook.
# Public key is included in docker/genesis/cordial-bonds.txt so the node can
# validate/propose in Cordial Miners mode.
CORDIAL_STANDALONE_PRIVATE_KEY=0101010101010101010101010101010101010101010101010101010101010101
CORDIAL_STANDALONE_PUBLIC_KEY=041b84c5567b126440995d3ed5aaba0565d71e1834604819ff9c17f5e9d5dd078f70beaf8f588b541507fed6a642c5ab42dfdf8120a7f639de5122d47a69a8e8d1

# Four-node local-intercept demo validator identities.
# These are development-only demo keys used to run the local convergence
# cluster with four distinct bonded validators.
CORDIAL_FOUR_NODE_1_PRIVATE_KEY=0101010101010101010101010101010101010101010101010101010101010101
CORDIAL_FOUR_NODE_1_PUBLIC_KEY=041b84c5567b126440995d3ed5aaba0565d71e1834604819ff9c17f5e9d5dd078f70beaf8f588b541507fed6a642c5ab42dfdf8120a7f639de5122d47a69a8e8d1
CORDIAL_FOUR_NODE_2_PRIVATE_KEY=0202020202020202020202020202020202020202020202020202020202020202
CORDIAL_FOUR_NODE_2_PUBLIC_KEY=044d4b6cd1361032ca9bd2aeb9d900aa4d45d9ead80ac9423374c451a7254d07662a3eada2d0fe208b6d257ceb0f064284662e857f57b66b54c198bd310ded36d0
CORDIAL_FOUR_NODE_3_PRIVATE_KEY=0303030303030303030303030303030303030303030303030303030303030303
CORDIAL_FOUR_NODE_3_PUBLIC_KEY=04531fe6068134503d2723133227c867ac8fa6c83c537e9a44c3c5bdbdcb1fe3379e92c265e71e481ba82a84675a47ac705a200fcd524e92d93b0e7386f26a5458
CORDIAL_FOUR_NODE_4_PRIVATE_KEY=0404040404040404040404040404040404040404040404040404040404040404
CORDIAL_FOUR_NODE_4_PUBLIC_KEY=04462779ad4aad39514614751a71085f2f10e1c7a593e4e030efb5b8721ce55b0b199c07969f5442000bea455d72ae826a86bfac9089cb18152ed756ebb2a596f5

# Real four-node cluster bootstrap identity.
# These values match the sibling f1r3node shard demo's bootstrap certificate
# and let the local Cordial cluster form a real connected network.
CORDIAL_BOOTSTRAP_HOST=cordial-boot
CORDIAL_BOOTSTRAP_NODE_ID=1e780e5dfbe0a3d9470a2b414f502d59402e09c2
CORDIAL_BOOTSTRAP_PRIVATE_KEY=5f668a7ee96d944a4494cc947e4005e172d7ab3461ee5538f1f2a45a835e9657

NATIVE_TOKEN_NAME=F1R3CAP
NATIVE_TOKEN_SYMBOL=F1R3
NATIVE_TOKEN_DECIMALS=8
